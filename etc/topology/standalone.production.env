# Bootstrap profile standalone.production — replace with application-specific values.
SDKWORK_INVENTORY_DEPLOYMENT_PROFILE=standalone
SDKWORK_INVENTORY_ENVIRONMENT=production
SDKWORK_INVENTORY_PROFILE_ID=standalone.production
SDKWORK_INVENTORY_APPLICATION_PUBLIC_HTTP_URL=https://inventory.sdkwork.com
SDKWORK_INVENTORY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_INVENTORY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
