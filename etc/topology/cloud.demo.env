# Isolated demo environment (cloud.demo).
# Independent database schema: sdkwork_inventory_demo
# Independent Redis prefix: inventory-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_INVENTORY_DEPLOYMENT_PROFILE=cloud
SDKWORK_INVENTORY_ENVIRONMENT=demo
SDKWORK_INVENTORY_PROFILE_ID=cloud.demo
SDKWORK_INVENTORY_APPLICATION_PUBLIC_HTTP_URL=https://inventory-demo.sdkwork.com
SDKWORK_INVENTORY_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_INVENTORY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://inventory-demo.sdkwork.com,http://inventory-demo.sdkwork.com,https://inventory-demo.birdcoder.com,http://inventory-demo.birdcoder.com,https://inventory-demo.dtupay.com,http://inventory-demo.dtupay.com,https://inventory-demo.noaper.com,http://inventory-demo.noaper.com,https://inventory-demo.sdkwork.cn,http://inventory-demo.sdkwork.cn,https://inventory-demo.birdcoder.cn,http://inventory-demo.birdcoder.cn,https://inventory-demo.dtupay.cn,http://inventory-demo.dtupay.cn,https://inventory-demo.noaper.cn,http://inventory-demo.noaper.cn,https://inventory-demo.skubc.com,http://inventory-demo.skubc.com,https://inventory-demo.skubc.cn,http://inventory-demo.skubc.cn,https://inventory-demo.zowalk.com,http://inventory-demo.zowalk.com,https://inventory-demo.zowalk.cn,http://inventory-demo.zowalk.cn,https://inventory-demo.offer86.com,http://inventory-demo.offer86.com,https://inventory-demo.offer86.cn,http://inventory-demo.offer86.cn,https://inventory-demo.86offer.com,http://inventory-demo.86offer.com,https://inventory-demo.86offer.cn,http://inventory-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
