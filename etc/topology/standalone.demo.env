# Isolated demo environment (standalone.demo).
# Independent database schema: sdkwork_inventory_demo
# Independent Redis prefix: inventory-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_INVENTORY_DEPLOYMENT_PROFILE=standalone
SDKWORK_INVENTORY_ENVIRONMENT=demo
SDKWORK_INVENTORY_PROFILE_ID=standalone.demo
SDKWORK_INVENTORY_APPLICATION_PUBLIC_HTTP_URL=https://inventory-demo.sdkwork.com
SDKWORK_INVENTORY_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_INVENTORY_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
